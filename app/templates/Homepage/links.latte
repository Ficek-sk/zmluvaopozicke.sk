{block title}Užitočné odkazy{/block}

{block content}
	<div class="content">
		<h2 class="title to-animate">Užitočné odkazy</h2>
		<p class="subtitle text-center to-animate">Na tejto stránke nájdete užitočné odkazy súvisiace priamo alebo nepriamo so zmluvou o pôžičke.</p>

		<div class="row">
			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.vymahanie-dlhov.sk">Advokátska kancelária</a></h3>
				  <p>Zaoberajúca sa vymáhaním pohľadávok</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.vymahanie-dlhov.sk">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>

			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.rsba.sk">Rozhodcovský Súd Bratislava</a></h3>
				  <p>Rozhodcovský Súd Bratislava</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.rsba.sk">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>

			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.zrsr.sk">Živnostenský register</a></h3>
				  <p>Zoznam živnostníkov zapísaných v ŽR SR</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.zrsr.sk">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>

			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.orsr.sk">Obchodný register</a></h3>
				  <p>Zoznam spoločností zapísaných v OR SR</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.orsr.sk">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>

			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.zbierka.sk">Zbierka zákonov</a></h3>
				  <p>Právne predpisy v SR</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.zbierka.sk">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>

			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.justice.gov.sk/Stranky/default.aspx">Ministerstvo spravodlivosti SR</a></h3>
				  <p>Ministerstvo spravodlivosti SR</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.justice.gov.sk/Stranky/default.aspx">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>

			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.exekutor.sk">Exekútorská komora Slovenskej republiky</a></h3>
				  <p>Zoznam exekútorov v SR</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.exekutor.sk">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>

			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.notar.sk">Notárska komora Slovenskej republiky</a></h3>
				  <p>Zoznam notárov v SR</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.notar.sk">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>

			<div class="col-md-6 to-animate">
				<div class="link list-item">
				  <h3><a href="http://www.epravo.cz">Právny informačný portál v Českej republike</a></h3>
				  <p>Zoznam právnych predpisov ČR</p>
					<a class="btn btn-outline-primary btn-sm" href="http://www.epravo.cz">
						<ion-icon name="link"></ion-icon> Navštíviť
					</a>
				</div>
			</div>
		</div>
	</div>
{/block}
