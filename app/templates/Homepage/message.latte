{block title}Napíšte nám{/block}

{block content}
    <div class="content">
        <h2 class="title to-animate">Napíšte nám</h2>
        <p class="subtitle text-center to-animate">
            Zvoľte si buď konzultáciu s advokátom alebo online konzultáciu kliknutím na príslušné tlačidlo nižšie.
        </p>

        <div class="content-text">
            <div class="row">
                <div class="col-md-6 to-animate">
                    <a href="https://ficek.sk/konzultacia-na-dialku.html" class="consultation-link text-center">
                        <div class="consultation-button">
                            <i class="fa fa-comments"></i><br />
                            Konzultácia s advokátom
                        </div>
                    </a>
                </div>

                <div class="col-md-6 to-animate">
                    <a href="https://admin.ficek.sk/online-pravna-poradna?webId=2" class="advice-link text-center">
                        <div class="advice-button">
                            <i class="fa fa-laptop"></i><br />
                            Online právna poradňa
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
{/block}

