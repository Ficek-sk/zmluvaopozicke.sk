    <!-- Sweetalert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2"></script>

{snippet popup}
    <script n:inner-foreach="$flashes as $flash">
        setTimeout(function () {
            swal({
                title: 'Úspech!',
                text: {$flash->message},
                type: {$flash->type},
                padding: '30px',
                customClass: 'animated fadeIn',
                confirmButtonClass: 'btn btn-primary',
                buttonsStyling: false
            })
        }, 1500);
    </script>
{/snippet}
{/if}

