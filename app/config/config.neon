parameters:
	recaptcha:
		url: https://www.google.com/recaptcha/api/siteverify

php:
	date.timezone: Europe/Prague
	# zlib.output_compression: yes

application:
	errorPresenter: Error

database:
	default:
		dsn: 'mysql:host=%database.host%;dbname=%database.dbname%'
		user: '%database.user%'
		password: '%database.password%'
	systemDatabase:
		dsn: 'mysql:host=%contractReview.host%;dbname=%contractReview.dbname%'
		user: '%contractReview.user%'
		password: '%contractReview.password%'

session:
		expiration: 14 days

services:
    authenticator: Authenticator
    routerFactory: RouterFactory
    formRepository: FormRepository
    messageRepository: MessageRepository
    router: @routerFactory::createRouter
    emailSender: EmailSender
    userRepository: UserRepository
    dlznikRepository: DlznikRepository
    contractReviewManager: ContractReviewManager
    - App\Model\SystemModel\SystemContext(@database.systemDatabase.context)
    - App\Model\SystemModel\LegalCounselQuestion
    - App\Model\SystemModel\LegalCounselQuestionAnswer
    - App\Model\SystemModel\LegalCounselQuestionRelatedUrl
    - App\Modules\Recaptcha\RecaptchaVerifier(%recaptcha.secret%)
    -
        class: App\Modules\Recaptcha\RecaptchaFormExtension(%recaptcha.site%)
        setup:
            - register('addReCaptcha')
        tags: [run]

includes:
    - parameters.neon
